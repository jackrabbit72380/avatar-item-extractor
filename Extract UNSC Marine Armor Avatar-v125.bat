if exist "%~dp0MyAvatar.glb" set EYES=--eyes-forward
if exist "%~dp0keep_shape.txt" set SHAPE=--keep-shape
if exist "%~dp0eyes_forward.txt" set EYES=--eyes-forward
%PY% "%BOOT%" "%~f0" "%CACHE%" --obj --out "%OUT%" %TINT% %PORT% %SHAPE% %EYES%
