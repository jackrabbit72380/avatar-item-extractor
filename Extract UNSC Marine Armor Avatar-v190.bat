%PY% "%BOOT%" "%~f0" "%CACHE%" --obj --out "%OUT%" %SHINE% %PORT% %EYES%
set "RC=%ERRORLEVEL%"
if "%RC%"=="0" goto :done
if "%RC%"=="3" goto :unparsed
